{
	"name": "devrivo-chatbot",
	"version": "0.1.0",
	"private": true,
	"description": "A free, customisable AI assistant for any WordPress site.",
	"license": "GPL-2.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/masudranawd/Devrivo-Chatbot.git"
	},
	"engines": {
		"node": ">=20.10"
	},
	"files": [
		"devrivo-chatbot.php",
		"uninstall.php",
		"readme.txt",
		"src",
		"assets-src",
		"build"
	],
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=assets-src",
		"start": "wp-scripts start --webpack-src-dir=assets-src",
		"lint:js": "wp-scripts lint-js ./assets-src",
		"format": "wp-scripts format ./assets-src",
		"check:size": "node scripts/check-size.mjs",
		"plugin-zip": "wp-scripts plugin-zip",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "composer test",
		"env:test": "wp-env run tests-cli --env-cwd=wp-content/plugins/devrivo-chatbot vendor/bin/phpunit",
		"env:plugin-check": "wp-env run cli wp plugin check devrivo-chatbot"
	},
	"devDependencies": {
		"@wordpress/env": "^12.0.0",
		"@wordpress/scripts": "^37.0.0"
	}
}
